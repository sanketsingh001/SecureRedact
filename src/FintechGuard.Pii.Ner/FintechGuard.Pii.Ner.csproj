<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FintechGuard.Pii\FintechGuard.Pii.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SecureRedact.Ner</PackageId>
    <Version>1.2.0</Version>
    <Authors>Sanket Singh</Authors>
    <Company>Sanket Singh</Company>
    <Description>ONNX BERT-NER named entity recognition plugin for SecureRedact. Enables high-throughput CPU-optimized neural token classification for names, addresses, and organizations in unstructured JSON fields.</Description>
    <PackageTags>pii;masking;ner;onnx;bert;token-classification;nlp;redaction;fintech;security</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sanketsingh001/SecureRedact</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sanketsingh001/SecureRedact</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
