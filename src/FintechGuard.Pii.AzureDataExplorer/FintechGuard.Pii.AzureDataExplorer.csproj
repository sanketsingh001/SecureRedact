<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FintechGuard.Pii\FintechGuard.Pii.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Kusto.Ingest" Version="14.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SecureRedact.AzureDataExplorer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Sanket Singh</Authors>
    <Company>Sanket Singh</Company>
    <Description>Azure Data Explorer (ADX / Kusto) integration for SecureRedact. Wraps IKustoIngestClient with a single .WithSecureRedact() call so all streams and files are transparently PII-masked before ingestion. Zero changes to your KQL queries or table schemas.</Description>
    <PackageTags>pii;masking;kusto;adx;azure-data-explorer;kusto-ingest;security;fintech;gdpr;redaction</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sanketsingh001/SecureRedact</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sanketsingh001/SecureRedact</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
